# Copie ce fichier vers .env et remplis les deux premieres lignes.
# .env est ignore par git : le jeton ne doit jamais partir dans le depot.

# --- Obligatoire ---------------------------------------------------------

# Portail developpeur > ton application > Bot > Reset Token
DISCORD_TOKEN=

# Portail developpeur > ton application > General Information > Application ID
DISCORD_APPLICATION_ID=

# --- Fortement conseille pendant la mise au point ------------------------

# Identifiant de ton serveur de jeu (Discord > mode developpeur > clic droit
# sur le serveur > Copier l identifiant). Renseigne : les commandes y
# apparaissent dans la seconde. Vide : deploiement global, jusqu a 1 h.
DISCORD_GUILD_ID=

# --- Facultatif ----------------------------------------------------------

# Ou sont rangees les musiques.
MUSIQUE_DIR=./assets/musique

# Volume de depart, de 0 a 2 (0.35 = 35 %, un fond sonore qui laisse parler).
VOLUME_DEFAUT=0.35

# Minutes de silence avant que le bot quitte le salon vocal. 0 pour ne jamais partir.
INACTIVITE_MINUTES=5

# Duree du fondu, en millisecondes : a l entree d une piste, a sa coupure, et
# a la fin d une piste dont la duree est connue. 0 pour couper net.
FONDU_MS=1500

# Niveau moyen vise, en dBFS, pour egaliser des fichiers d origines diverses :
# sans ca, la piste de combat hurle et l ambiance chuchote. Le bot mesure
# chaque piste une fois avec ffmpeg et corrige. 0 desactive la correction.
NIVEAU_CIBLE_DB=-20

# Secondes entre deux rafraichissements de la barre de progression du panneau.
# 0 fige la barre : elle ne bougera plus qu au clic. En dessous de 5, Discord
# finit par limiter les editions du message.
PANNEAU_SECONDES=10

# debug | info | warn | error
LOG_LEVEL=info
